  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: Alright, I made it to the base with all the pirates.
    emotion: 0
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: I'm suprised that they're close to my hometown.
    emotion: 0
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: Alright, time to fight them all for gold!
    emotion: 1
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: ...........wait a second...
    emotion: 6
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: dammit! I left my weapons back at school!
    emotion: 4
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: I'm completely unable to defend myself!
    emotion: 4
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: Well, I guess I have to sneak by all the pirates.
    emotion: 6
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
  - Text: I'm sure this won't end badly.
    emotion: 6
    name: 
    sound: {fileID: 8300000, guid: 86c0c0a5e3a75ff42a0030803f8a4275, type: 3}
