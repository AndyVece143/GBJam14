    name: 
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: I've come too far to lose now!
    emotion: 3
    name: 
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Time to get my college fund!
