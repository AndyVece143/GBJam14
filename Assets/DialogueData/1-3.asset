MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 26063e7e2da525d4cb1d8e301cd247b3, type: 3}
  m_Name: 1-3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: Oh, it's a sign. Just appeared out of nowhere.
    emotion: 0
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Sure, that makes sense. What's up, guy?
    emotion: 2
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 1
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Do I want money? Of course I do!
    emotion: 1
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: What do I have to do to get it?
    emotion: 1
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 2
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Pirates, eh? They still exist? I didn't know.
    emotion: 2
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Why should I go see them?
    emotion: 2
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 3
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Ah, that makes sense. They would have gold.
    emotion: 0
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: I'll go see them now. I bet they're nice!
    emotion: 1
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 4
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: God dammit, they're mean pirates. Of course.
    emotion: 6
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Well, it looks like I'm gonna have to steal it.
    emotion: 0
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 5
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Thanks, I'll need it if I wanna stay in one piece.
    emotion: 1
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Heh... get it?
    emotion: 1
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: ...
    emotion: 0
    name: Sign
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  - Text: Oof, tough crowd. Anyway, time to go!
    emotion: 0
    name: Pearl
    sound: {fileID: 8300000, guid: fe9aaa4f842912847ac67bb08e50481c, type: 3}
  Character1: {fileID: 0}
  Character2: {fileID: 0}
  canPlayerMove: 0
  chapter1: 1
  chapter2: 0
  chapter3: 0
