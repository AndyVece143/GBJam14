      objectReference: {fileID: 0}
    - target: {fileID: 8740465274458733762, guid: 5365b01e649ac854c82d33895f30d159, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: Yo! You're back! It's good to see you!
      objectReference: {fileID: 0}
    - target: {fileID: 8740465274458733762, guid: 5365b01e649ac854c82d33895f30d159, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: A bit has changed since you were gone.
      objectReference: {fileID: 0}
    - target: {fileID: 8740465274458733762, guid: 5365b01e649ac854c82d33895f30d159, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: Why don't you take a look around? Go inside houses too.
      objectReference: {fileID: 0}
    - target: {fileID: 8740465274458733762, guid: 5365b01e649ac854c82d33895f30d159, type: 3}
      propertyPath: 'dialogue2.Array.data[0]'
      value: Me? I'm gonna stay right here.
      objectReference: {fileID: 0}
    - target: {fileID: 8740465274458733762, guid: 5365b01e649ac854c82d33895f30d159, type: 3}
      propertyPath: 'dialogue2.Array.data[1]'
      value: I picked out this spot myself, so I can't leave.
      objectReference: {fileID: 0}
