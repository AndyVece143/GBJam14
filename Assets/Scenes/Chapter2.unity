      value: Paper
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: dialogue1.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: '"I finally managed to score big in life!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: '"I sold some guy a god awful color palette!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: '"He paid top dollar for it. What a fool!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[3]'
      value: '"Now all this money is mine! I''m so happy!"'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[4]'
      value: '"I''m gonna go out for a nice long stroll."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[5]'
      value: '"I sure hope all the money is still here when I come back!"'
      objectReference: {fileID: 0}
