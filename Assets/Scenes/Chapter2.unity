--- !u!1001 &1449795365
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 887875668}
    m_Modifications:
    - target: {fileID: 5722122920270663894, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: m_Name
      value: Paper
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: dialogue1.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: '"Hey, wanna get past the pirates? Here''s some advice."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: '"They always walk between the same two points."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: '"Their line of sight is directly in front of them."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[3]'
      value: '"If you get caught, get to a new area quickly."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[4]'
      value: '"They''ll get bored chasing you."'
      objectReference: {fileID: 0}
    - target: {fileID: 8570521544917810019, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: 'dialogue1.Array.data[5]'
      value: '"They''ll get bored chasing you."'
      objectReference: {fileID: 0}
    - target: {fileID: 8908220697656185845, guid: 3a60922543e44c447932b8dab8cbb4f2, type: 3}
      propertyPath: m_LocalPosition.x
      value: 120
